# Copy to .env and override as needed.
# Never commit .env to version control.

# === Environment ===
APP_ENV=development
# Set to "production" for production deployments.

# === Database: PostgreSQL with PostGIS ===
# Production: use managed PostgreSQL or connect to your own Postgres instance.
# Example: postgresql+asyncpg://user:pass@hostname:5432/dbname
DATABASE_URL=postgresql+asyncpg://yenimenzil:yenimenzil@localhost:5432/yenimenzil

# === Redis ===
# Production: connect to your Redis instance (Elasticache, self-hosted, etc.)
REDIS_URL=redis://localhost:6379/0

# === CORS ===
# Comma-separated list of allowed CORS origins.
# In production, replace with your actual frontend domain(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# === Security ===
# SECRET_KEY: must be at least 32 random bytes for HMAC-SHA256.
# Generate with: openssl rand -base64 32
# Override via environment variable in production.
SECRET_KEY=change-me-in-production
COOKIE_SECURE=false
# Optional shared cookie domain, for example .yenimenzil.az
COOKIE_DOMAIN=

# API settings
NEXT_PUBLIC_API_URL=https://api.yenimenzil.az/api/v1
NEXT_PUBLIC_APP_URL=https://yenimenzil.az
NEXT_PUBLIC_USE_DEMO_DATA=true
PUBLIC_APP_URL=http://localhost:3000

# Map tiles (OSM or custom)
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# === MinIO / S3-compatible (for image uploads) ===
# For production S3/R2, set these accordingly.
# If using MinIO, keep the defaults but adjust the hostname/port.
S3_ENDPOINT=localhost:9000
S3_BUCKET=yenimenzil-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/media
S3_SECURE=false

# === Email (SMTP) ===
# Configure SMTP for transactional emails (password reset, verification, etc.)
# These values are read by the application at startup.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@yenimenzil.az

# === Payment provider ===
# Payment provider: mock (local dev), stripe (optional production) or manual.
# In production, set a real provider and configure its credentials.
# Mock payments are only allowed when ALLOW_MOCK_PAYMENTS_IN_PROD=true (staging).
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS_IN_PROD=false

# === Listings ===
# How long a published listing stays live before auto-expiry (days).
PROPERTY_LISTING_DAYS=60

# === Admin MFA ===
# Admin MFA issuer display name.
ADMIN_MFA_ISSUER=YeniMenzil.az

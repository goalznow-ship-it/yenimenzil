# Copy to .env and override as needed.
# Never commit .env to version control.

APP_ENV=development
# Database: PostgreSQL with PostGIS
DATABASE_URL=postgresql+asyncpg://yenimenzil:yenimenzil@localhost:5432/yenimenzil
# Redis
REDIS_URL=redis://localhost:6379/0
# CORS origins (adjust for your frontend URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# SECRET_KEY: must be at least 32 random bytes for HMAC-SHA256.
# Generate with: openssl rand -base64 32   (or 32 bytes in hex/base64)
# Example (do not use this in production): SECRET_KEY=dev-only-secret-key-change-me-123456789012
SECRET_KEY=dev-only-secret-key-change-me-123456789012
# API URL (used by frontend)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Map tiles (OSM or custom)
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png


# MinIO (for image uploads) - S3 compatible settings
S3_ENDPOINT=localhost:9002
S3_BUCKET=yenimenzil-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9002
S3_SECURE=false

# ── YeniMenzil.az environment ─────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# ── Web app ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── API (apps/api) ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://yenimenzil:yenimenzil@localhost:5432/yenimenzil
REDIS_URL=redis://localhost:6379/0
API_SECRET_KEY=change-me-in-production
API_ACCESS_TOKEN_TTL_MINUTES=15
API_REFRESH_TOKEN_TTL_DAYS=30

# ── Object storage (MinIO local / S3 / R2 in prod) ───────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=yenimenzil
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

# ── Demo data / features ──────────────────────────────────────────────────
NEXT_PUBLIC_USE_DEMO_DATA=true
FEATURE_PRICE_INTELLIGENCE=true
FEATURE_TRUST_SCORE=false

# ── Analytics / observability (optional) ──────────────────────────────────
# SENTRY_DSN=

# Copy to .env and override as needed.
# Never commit .env to version control.

# === Environment ===
APP_ENV=production
# Set to "development" or "staging" for non-production deployments.

# === Database: PostgreSQL with PostGIS ===
# Production: use managed PostgreSQL or connect to your own Postgres instance.
# Example: postgresql+asyncpg://user:pass@hostname:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yenimenzil

# === Redis ===
# Production: connect to your Redis instance (Elasticache, self-hosted, etc.)
REDIS_URL=redis://localhost:6379/0

# === CORS ===
# Comma-separated list of allowed CORS origins.
# In production, replace with your actual frontend domain(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# === Security ===
# SECRET_KEY: must be at least 32 random bytes for HMAC-SHA256.
# Generate with: openssl rand -base64 32
# Override via environment variable in production.
SECRET_KEY=change-me-in-production

# API settings
NEXT_PUBLIC_API_URL=https://api.yenimenzil.az/api/v1
NEXT_PUBLIC_APP_URL=https://yenimenzil.az

# Map tiles (OSM or custom)
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# === MinIO / S3-compatible (for image uploads) ===
# For production S3/R2, set these accordingly.
# If using MinIO, keep the defaults but adjust the hostname/port.
S3_ENDPOINT=localhost:9002
S3_BUCKET=yenimenzil-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9002
S3_SECURE=false

# === Email (SMTP) ===
# Configure SMTP for transactional emails (password reset, verification, etc.)
# These values are read by the application at startup.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@yenimenzil.az

# === Payment Provider ===
# Payment provider abstraction - configure your preferred provider.
# Currently supported: stripe, payme, manual.
PAYMENT_PROVIDER=stripe
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# === Background Workers ===
# Redis URL for Celery/RQ task queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === Admin MFA ===
# Admin multi-factor authentication settings
ADMIN_MFA_ISSUER=YeniMenzil.az
ADMIN_MFA_SMTP_SENDER=no-reply@yenimenzil.az

# === Rate Limiting ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_BURST=20

# === Observability ===
# Structured logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === Backup ===
# Backup schedule and retention
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_CRON=0 2 * * *